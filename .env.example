# Copy to .env and fill in. Get a free Gemini key at https://aistudio.google.com
# Without a key (or with LLM_PROVIDER=offline) the system runs fully deterministic: rule parser + templates.
# LLM_PROVIDER: gemini | offline
LLM_PROVIDER=gemini
GEMINI_API_KEY=

LLM_MODEL_DEFAULT=gemini-3.5-flash
LLM_MODEL_INTAKE=gemini-3.5-flash
LLM_MODEL_EMAIL=gemini-3.5-flash
LLM_MODEL_SUMMARY=gemini-3.5-flash
LLM_MODEL_ADJUDICATOR=gemini-3.5-flash
# Tried in order when a model fails or its free-tier daily quota (20 requests/day/model) is exhausted
LLM_FALLBACK_MODELS=["gemini-3.5-flash-lite","gemini-3.1-flash-lite"]
LLM_REQUEST_TIMEOUT_S=60

# Free-tier friendly throttling
LLM_MAX_CONCURRENCY=2
LLM_RPM=10
MAX_LLM_EMAILS=25
# Most severe flagged orders investigated by the tool-using agent (a few LLM calls each; 0 disables)
MAX_AGENT_CASES=2

# Simulation clock (the dataset ends in 2018)
AS_OF=2018-08-01T00:00:00

# --- Security -------------------------------------------------------------------------------------------------
# Sign-in with roles: analyst (run, edit, draft) < approver (approve, reject, send) < admin.
AUTH_ENABLED=true
# Demo accounts analyst@ / approver@ / admin@example.com are seeded when missing.
# For a real deployment: DEMO_USERS=false, then
#   docker compose run --rm api python -m app.cli create-user --email you@company.com --role admin
DEMO_USERS=true
# Self-service sign-up creates analyst accounts only; an admin grants approver/admin on the Users page.
ALLOW_SIGNUP=true
# Restrict sign-up to company domains (JSON list), e.g. ["company.com"]
# SIGNUP_ALLOWED_DOMAINS=[]
# Token signing key. When empty, a random key is generated once and kept in the data volume.
# JWT_SECRET=
JWT_TTL_MINUTES=720
# Service credential for scripts/CI: requests with this X-API-Key header act as admin.
# API_KEY=
# Database password (used by both the postgres service and the backend).
# POSTGRES_PASSWORD=

# --- Outbound email -------------------------------------------------------------------------------------------
# Approved emails are delivered over SMTP. The local stack points at Mailpit (inbox at http://localhost:8025).
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# SMTP_FROM=Olist Customer Care <care@olist.example>

# --- Linux only: owner of the report files that `make samples/backtest/eval` write into ./samples ---------------
# APP_UID=1000
# APP_GID=1000
